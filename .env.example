# Copy this file to .env and fill in the values:   cp .env.example .env
# NEVER commit .env. This repository is public: anything pushed is visible to everyone.
# P2 sends the secret values in a private message.

# ---------------------------------------------------------------------------
# MongoDB Atlas (hackathon sandbox project): `traceback_app` user (SECRET)
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://traceback_app:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=traceback
# Your own database while developing: traceback_p1 | traceback_p2 | traceback_p3
# Rehearsals and the live demo use: traceback_demo
MONGODB_DB=traceback_p1

# ---------------------------------------------------------------------------
# Database for the practice apps, used only by the runner.
# Default: local Docker:  docker run -d --name fixture-mongo -p 27018:27017 mongo
# Atlas fallback: the fixed database `traceback_fixture`, with collections prefixed by run id.
# ---------------------------------------------------------------------------
FIXTURE_MONGODB_URI=mongodb://localhost:27018

# ---------------------------------------------------------------------------
# Voyage embeddings through Atlas AI Model APIs (SECRET key)
# Rate-limited? Switch to a direct Voyage account:
#   VOYAGE_BASE_URL=https://api.voyageai.com/v1 and that account's key
# ---------------------------------------------------------------------------
VOYAGE_API_KEY=
VOYAGE_BASE_URL=https://ai.mongodb.com/v1
EMBEDDING_MODEL=voyage-4-lite
EMBEDDING_DIMENSIONS=1024

# ---------------------------------------------------------------------------
# LLM used by the agent (SECRET key)
# LLM_PROVIDER: anthropic | openai
# LLM_MODEL: the exact model name; it is recorded in every run
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# ---------------------------------------------------------------------------
# ElevenLabs voice agent "Traceback On-Call" (P1-8)
# The agent id is not secret. The API key is only needed if the agent requires
# authentication (signed session URL); it NEVER goes into web/.
# ---------------------------------------------------------------------------
ELEVENLABS_AGENT_ID=
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Agent budgets per run
# ---------------------------------------------------------------------------
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_PATCH_ATTEMPTS=2
AGENT_DEADLINE_SECONDS=120
# auto = fall back to fakes when the fixture DB / Atlas is unreachable (logged). local / atlas = refuse to start.
AGENT_RUNNER=auto
AGENT_STORE=auto
# false on experiment servers (evals/run_ablation.py): runs never create new memories
AGENT_PROMOTE=true

# ---------------------------------------------------------------------------
# Demo identities: API key -> principal. Fake, local-only values; NOT real auth.
# Sent by the UI in the X-API-Key header; switched with the identity pill.
# ---------------------------------------------------------------------------
DEMO_PRINCIPALS={"key-payments-eng":{"tenantId":"demo-org","teamId":"team-payments","role":"engineer","authorizedRepos":["payments-webhooks"]},"key-payments-admin":{"tenantId":"demo-org","teamId":"team-payments","role":"memory_admin","authorizedRepos":["payments-webhooks"]},"key-platform-eng":{"tenantId":"demo-org","teamId":"team-platform","role":"engineer","authorizedRepos":["platform-webhooks"]},"key-platform-admin":{"tenantId":"demo-org","teamId":"team-platform","role":"memory_admin","authorizedRepos":["platform-webhooks"]}}
